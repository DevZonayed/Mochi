{
  "name": "mochi-server",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "description": "MCP server for the Mochi browser companion — speaks stdio MCP to AI clients and WebSocket to the Chrome extension. Bundled with esbuild into dist/server.bundle.mjs.",
  "bin": {
    "mochi": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.bundle.mjs --legal-comments=external --banner:js=\"import{createRequire as ___cr}from'node:module';const require=___cr(import.meta.url);\"",
    "test": "node _smoke.mjs && node _uploads.test.mjs && node _upload_wire.test.mjs && node _integration.mjs && node _multi-client.mjs",
    "test:smoke": "node _smoke.mjs",
    "test:integration": "node _integration.mjs",
    "test:multi": "node _multi-client.mjs",
    "test:e2e:upload": "node _upload_e2e.mjs",
    "test:ws": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "undici": "^7.25.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=20"
  }
}
